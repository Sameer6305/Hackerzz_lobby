NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────
# Local SQLite (default for development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production — uncomment and fill in):
# DATABASE_URL="postgresql://user:password@host:5432/hackerzz_lobby?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/hackerzz_lobby?sslmode=require"
#
# Recommended hosted providers:
#   - Neon (neon.tech) — free tier, serverless PostgreSQL
#   - Supabase (supabase.com) — free tier, includes auth & storage
#   - Railway (railway.app) — simple deploy with $5/mo credit
#
# When switching to PostgreSQL:
#   1. Update DATABASE_URL above
#   2. Change provider in prisma/schema.prisma from "sqlite" to "postgresql"
#   3. Run: npx prisma migrate dev --name init
#   4. Run: node prisma/seed.js

# ─── JWT ───────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random string (32+ chars) in production
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── GitHub API ────────────────────────────────────────────
# Optional — works without token at 60 req/hr, with token 5000 req/hr
# Create a token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── CORS ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Cache ─────────────────────────────────────────────────
GITHUB_CACHE_TTL=600