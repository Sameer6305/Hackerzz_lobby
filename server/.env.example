NODE_ENV=production
PORT=5000

# ─── Database (Neon PostgreSQL) ────────────────────────────
# 1. Sign up at https://neon.tech → New Project
# 2. Copy "Pooled connection" string → DATABASE_URL
# 3. Copy "Direct connection" string → DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# ─── JWT ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ───────────────────────────────────
# Set this to your Vercel deployment URL
CLIENT_URL=https://your-app.vercel.app

# ─── GitHub API ────────────────────────────────────────────
# Optional — 60 req/hr without token, 5000/hr with token
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_CACHE_TTL=600